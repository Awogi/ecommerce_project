# Generated .gitignore for ecommerce_project
# Keep secrets, build artifacts and editor files out of git

### Rust / Cargo ###
/target/
/**/target/
/Cargo.lock
**/Cargo.lock

# If using rust-analyzer or other caches
/**/target/
/.idea/

### Diesel / Migrations ###
# Migrations SQL files are usually committed, but if you keep local secrets or DB files, ignore them
# Example: ignore any local sqlite db
/*.db
/*.sqlite

### Environment / Secrets ###
# dotenv, environment files, credentials, keys
.env
.env.*
secrets.env
*.pem
*.key
private-keys/
keys/
credentials/

### Node / frontend / wasm ###
/node_modules/
/pkg/
/dist/
/build/

### VS Code / IDEs ###
/.vscode/
.idea/
*.sublime-workspace
*.sublime-project

### OS generated files ###
Thumbs.db
desktop.ini
Icon?
ehthumbs.db

### Logs and temp files ###
/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

### Credentials and local configs ###
.netrc
.credentials
credentials.json

### Build outputs and packaging ###
/target/
/release/
*.rlib
*.rmeta

### Editor swap/backup files ###
*~
# Emacs
*\#*
.#*
# Vim
*.swp
*.swo

### Misc ###
/.DS_Store
.DS_Store

# End of .gitignore
